# Copy to deploy/fmi/.env (never commit). Used by docker-compose.yml.
POSTGRES_PASSWORD=CHANGEME_strong_random_password

# Also create backend/.env from backend/.env.example with these values:
#   DB_HOST=db  DB_NAME=dokcrm  DB_USER=dokcrm  DB_PASSWORD=<same as POSTGRES_PASSWORD>
#   NODE_ENV=production  PORT=4000
#   JWT_SECRET / SA_JWT_SECRET = two different random 64-byte hex values
#   CORS_ORIGIN=https://fmi.crmstack.site
#   APP_BASE_URL=https://fmi.crmstack.site
#   SMTP_* = FMI / DOK mail settings
