# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dokcrm
DB_USER=dokcrm
DB_PASSWORD=CHANGEME_use_a_strong_random_password

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEME_64_char_random_hex
JWT_EXPIRES_IN=7d

# Super Admin JWT — use a DIFFERENT secret from JWT_SECRET
SA_JWT_SECRET=CHANGEME_64_char_random_hex_different

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (leave empty for localhost-only in dev)
# Production example: CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=

# Email (Outlook SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your@outlook.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@crmstack.com

# Frontend base URL (used for password reset links)
APP_BASE_URL=http://localhost:3000
