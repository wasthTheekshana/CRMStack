# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dokcrm
DB_USER=dokcrm
DB_PASSWORD=CHANGEME_use_a_strong_random_password

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEME_64_char_random_hex
JWT_EXPIRES_IN=7d

# Super Admin JWT — use a DIFFERENT secret from JWT_SECRET
SA_JWT_SECRET=CHANGEME_64_char_random_hex_different

# Server
PORT=4000
NODE_ENV=development

# Optional: override the login rate limit (attempts / 15 min / IP).
# Leave UNSET in real production (defaults to 10). A dockerized dev/e2e stack runs
# NODE_ENV=production, so set this high there to let the e2e suite run many logins.
# LOGIN_RATE_LIMIT_MAX=10000

# Optional: set to false to allow non-Secure cookies when a NODE_ENV=production stack
# is served over plain http://localhost (docker dev/e2e). Leave UNSET in real production.
# COOKIE_SECURE=false

# CORS — comma-separated list of allowed origins (leave empty for localhost-only in dev)
# Production example: CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
# For a local docker dev stack served at http://localhost, include it here, e.g.:
#   CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:3000
CORS_ORIGIN=

# Email (Outlook SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your@outlook.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@crmstack.com

# Frontend base URL (used for password reset links)
APP_BASE_URL=http://localhost:3000
